<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actividad de Reforzamiento: Derivadas</title>
    
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']]
            },
            svg: { fontCache: 'global' }
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #e67e22;
            --success: #27ae60;
            --danger: #e74c3c;
            --gray: #95a5a6;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background: #f4f7f6; color: #333; line-height: 1.6; padding: 20px; }
        .container { max-width: 850px; margin: 0 auto; background: #fff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden; }
        header { background: var(--primary); color: #fff; padding: 25px; text-align: center; }
        header h1 { font-size: 1.8rem; margin-bottom: 5px; }
        header h2 { font-size: 1.1rem; font-weight: 400; opacity: 0.9; }
        section { padding: 25px; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: 600; }
        input[type="text"], input[type="date"] { width: 100%; padding: 10px; border: 2px solid #ddd; border-radius: 6px; font-size: 1rem; margin-bottom: 10px; box-sizing: border-box; }
        .btn { display: inline-block; background: var(--secondary); color: #fff; padding: 12px 25px; border: none; border-radius: 6px; cursor: pointer; font-size: 1rem; font-weight: 600; transition: background 0.3s; width: 100%; margin-top: 10px; }
        .btn:hover { background: #d35400; }
        .btn:disabled { background: var(--gray); cursor: not-allowed; }
        .btn-next { background: var(--primary); }
        .btn-next:hover { background: #1a252f; }
        
        .stats-bar { display: flex; justify-content: space-between; background: #f8f9fa; padding: 10px 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; flex-wrap: wrap; gap: 10px; }
        .stat-item span { color: var(--secondary); }
        .progress-container { height: 8px; background: #e0e0e0; border-radius: 4px; margin: 15px 0; overflow: hidden; }
        .progress-bar { height: 100%; background: var(--success); width: 0%; transition: width 0.4s ease; }
        
        .question-box { margin-bottom: 20px; }
        .question-text { font-size: 1.2rem; margin-bottom: 20px; font-weight: 500; background: #fdfefe; padding: 15px; border-radius: 8px; border-left: 5px solid var(--secondary); }
        .options { display: grid; gap: 10px; }
        .option-btn { padding: 12px; background: #fff; border: 2px solid #ddd; border-radius: 8px; cursor: pointer; text-align: left; transition: all 0.2s; font-size: 1.1rem; width: 100%; }
        .option-btn:hover:not(.disabled) { border-color: var(--secondary); background: #fef5e7; }
        .option-btn.selected { border-color: var(--secondary); background: #fdebd0; font-weight: 600; }
        .option-btn.correct { border-color: var(--success); background: #d5f5e3; }
        .option-btn.incorrect { border-color: var(--danger); background: #fadbd8; }
        .option-btn.disabled { pointer-events: none; opacity: 0.7; }
        
        .feedback { margin-top: 15px; padding: 12px; border-radius: 6px; display: none; }
        .feedback.correct { background: #d5f5e3; color: #145a32; border: 1px solid #27ae60; }
        .feedback.incorrect { background: #fadbd8; color: #7b241c; border: 1px solid #e74c3c; }
        
        .results-box { text-align: center; }
        .score-circle { width: 120px; height: 120px; background: var(--secondary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 700; margin: 20px auto; }
        .hidden { display: none !important; }
        
        @media (max-width: 600px) {
            body { padding: 10px; }
            section { padding: 15px; }
            .option-btn { font-size: 1rem; padding: 10px; }
            .stats-bar { font-size: 0.9rem; }
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Actividad de Reforzamiento</h1>
        <h2>Cálculo Diferencial | Derivadas</h2>
    </header>

    <section id="registro">
        <div class="form-group">
            <label for="nombre">Nombre del Estudiante</label>
            <input type="text" id="nombre" placeholder="Tu nombre completo">
            <label for="fecha">Fecha de Realización</label>
            <input type="date" id="fecha">
        </div>
        <button class="btn" onclick="startQuiz()">Iniciar Evaluación</button>
    </section>

    <section id="actividad" class="hidden">
        <div class="stats-bar">
            <div class="stat-item">✅ <span id="correct-count">0</span></div>
            <div class="stat-item">❌ <span id="error-count">0</span>/10</div>
            <div class="stat-item">📊 <span id="progress-pct">0%</span></div>
        </div>
        <div class="progress-container">
            <div class="progress-bar" id="progress-bar"></div>
        </div>

        <div id="question-container">
            <div class="question-box">
                <p class="question-text" id="q-text"></p>
                <div class="options" id="options-container"></div>
                <div id="feedback" class="feedback"></div>
            </div>
            <button class="btn btn-next" id="btn-next" onclick="nextQuestion()" disabled>Siguiente</button>
        </div>
    </section>

    <section id="resultados" class="hidden">
        <div class="results-box">
            <h2>Resultado para <span id="student-name-display"></span></h2>
            <div class="score-circle" id="final-score">0%</div>
            <div id="personal-message" style="margin: 20px 0; font-size: 1.1rem;"></div>
            <button class="btn" onclick="location.reload()">Reiniciar Actividad</button>
        </div>
    </section>
</div>

<script>
    // 20 reactivos tomados de los ejercicios propuestos de DERIVADAS
    const questions = [
        // ==================== SECCIÓN 1: Interpretar derivada en contextos ====================
        {
            q: "Si $f'(2) = 5$, ¿qué significa geométricamente?",
            options: ["La pendiente de la recta tangente en $x=2$ es 5", "La función vale 5 en $x=2$", "La función es decreciente en $x=2$", "La función tiene un máximo en $x=2$"],
            correct: 0,
            explanation: "La derivada en un punto representa la pendiente de la recta tangente a la curva en ese punto."
        },
        {
            q: "Si $v'(t) = -10$ m/s² en un movimiento, ¿qué indica?",
            options: ["La aceleración es negativa (desaceleración)", "La velocidad es -10 m/s", "La posición es -10 m", "La velocidad está aumentando"],
            correct: 0,
            explanation: "La derivada de la velocidad respecto al tiempo es la aceleración. Un valor negativo indica desaceleración o aceleración en dirección opuesta al movimiento."
        },
        {
            q: "Si la ganancia $G'(x) = 50$ dólares/unidad, ¿qué significa?",
            options: ["Por cada unidad adicional, la ganancia aumenta $50", "La ganancia total es $50", "El costo es $50 por unidad", "La ganancia es constante"],
            correct: 0,
            explanation: "La derivada de la ganancia respecto a la cantidad producida es la ganancia marginal, que indica el cambio en la ganancia por unidad adicional producida."
        },
        {
            q: "Si la población $P'(t) = 100$ personas/año, ¿qué sucede?",
            options: ["La población crece a razón de 100 personas por año", "La población es 100 personas", "La población decrece a razón de 100 personas por año", "La población se duplica cada año"],
            correct: 0,
            explanation: "La derivada de la población respecto al tiempo indica la tasa de crecimiento instantánea. Un valor positivo de 100 significa crecimiento de 100 personas por año en ese instante."
        },
        {
            q: "Si $f'(x) = 0$ en un punto, ¿qué podría indicar?",
            options: ["Un máximo, mínimo o punto de inflexión", "La función es creciente", "La función es decreciente", "La función no está definida"],
            correct: 0,
            explanation: "Cuando la derivada es cero, la recta tangente es horizontal, lo que puede indicar un máximo local, un mínimo local o un punto de inflexión con tangente horizontal."
        },
        {
            q: "Si la temperatura $T'(h) = -2$ °C/hora, ¿qué sucede?",
            options: ["La temperatura está disminuyendo a razón de 2°C por hora", "La temperatura es -2°C", "La temperatura está aumentando a razón de 2°C por hora", "La temperatura es constante"],
            correct: 0,
            explanation: "La derivada de la temperatura respecto al tiempo es la tasa de cambio. Un valor negativo indica que la temperatura está disminuyendo a 2°C por hora."
        },

        // ==================== SECCIÓN 2: Regla de potencia ====================
        {
            q: "Para $f(x) = x^3$, encuentre $f'(x)$ usando la regla de potencia.",
            options: ["$3x^2$", "$x^2$", "$3x^3$", "$2x^2$"],
            correct: 0,
            explanation: "Regla de potencia: $(x^n)' = nx^{n-1}$. Para $n=3$: $3x^{3-1}=3x^2$."
        },
        {
            q: "Para $f(x) = x^4$, encuentre $f'(x)$ usando la regla de potencia.",
            options: ["$4x^3$", "$x^3$", "$4x^4$", "$3x^3$"],
            correct: 0,
            explanation: "Regla de potencia: $(x^n)' = nx^{n-1}$. Para $n=4$: $4x^{4-1}=4x^3$."
        },
        {
            q: "Para $f(x) = 2x^2$, encuentre $f'(x)$ usando la regla de potencia.",
            options: ["$4x$", "$2x$", "$x$", "$4x^2$"],
            correct: 0,
            explanation: "Regla de potencia con constante: $(cf)' = cf'$. $2x^2 \\to 2\\cdot 2x^{2-1}=4x$."
        },
        {
            q: "Para $f(x) = 3x$, encuentre $f'(x)$ usando la regla de potencia.",
            options: ["$3$", "$1$", "$3x$", "$0$"],
            correct: 0,
            explanation: "$3x = 3x^1$. $(3x^1)' = 3\\cdot 1\\cdot x^0 = 3$."
        },
        {
            q: "Para $f(x) = x^5$, encuentre $f'(x)$ usando la regla de potencia.",
            options: ["$5x^4$", "$x^4$", "$5x^5$", "$4x^4$"],
            correct: 0,
            explanation: "Regla de potencia: $(x^n)' = nx^{n-1}$. Para $n=5$: $5x^{5-1}=5x^4$."
        },
        {
            q: "Para $f(x) = -2x^3$, encuentre $f'(x)$ usando la regla de potencia.",
            options: ["$-6x^2$", "$-2x^2$", "$-6x^3$", "$6x^2$"],
            correct: 0,
            explanation: "Regla de potencia con constante: $-2x^3 \\to -2\\cdot 3x^{3-1} = -6x^2$."
        },

        // ==================== SECCIÓN 3: Derivadas de funciones más complejas ====================
        {
            q: "Para $f(x) = x^3 + 2x^2 + x + 1$, encuentre $f'(x)$.",
            options: ["$3x^2 + 4x + 1$", "$3x^2 + 2x + 1$", "$x^2 + 2x + 1$", "$3x^2 + 4x$"],
            correct: 0,
            explanation: "Derivando término a término: $(x^3)'=3x^2$, $(2x^2)'=4x$, $(x)'=1$, $(1)'=0$. Sumando: $3x^2+4x+1$."
        },
        {
            q: "Para $f(x) = 5x^2 - 3x + 2$, encuentre $f'(x)$.",
            options: ["$10x - 3$", "$5x - 3$", "$10x + 3$", "$10x$"],
            correct: 0,
            explanation: "Derivando término a término: $(5x^2)'=10x$, $(-3x)'=-3$, $(2)'=0$. Sumando: $10x-3$."
        },
        {
            q: "Para $f(x) = \\frac{1}{2}x^4 - 2x^3 + 5x$, encuentre $f'(x)$.",
            options: ["$2x^3 - 6x^2 + 5$", "$\\frac{1}{2}x^3 - 6x^2 + 5$", "$2x^3 - 6x^2$", "$2x^3 - 2x^2 + 5$"],
            correct: 0,
            explanation: "Derivando término a término: $(\\frac{1}{2}x^4)'=2x^3$, $(-2x^3)'=-6x^2$, $(5x)'=5$. Sumando: $2x^3-6x^2+5$."
        },
        {
            q: "Para $f(x) = -x^3 + 3x^2 - 2x + 7$, encuentre $f'(x)$.",
            options: ["$-3x^2 + 6x - 2$", "$-3x^2 + 3x - 2$", "$-x^2 + 3x - 2$", "$-3x^2 + 6x$"],
            correct: 0,
            explanation: "Derivando término a término: $(-x^3)'=-3x^2$, $(3x^2)'=6x$, $(-2x)'=-2$, $(7)'=0$. Sumando: $-3x^2+6x-2$."
        },
        {
            q: "Para $s(t) = 4.9t^2$ (caída libre), encuentre la velocidad $v(t) = s'(t)$.",
            options: ["$9.8t$", "$4.9t$", "$9.8$", "$4.9t^2$"],
            correct: 0,
            explanation: "Derivando: $(4.9t^2)' = 4.9\\cdot 2t = 9.8t$."
        },
        {
            q: "Para $C(x) = 100 + 20x - x^2$ (costo total), encuentre el costo marginal $C'(x)$.",
            options: ["$20 - 2x$", "$20 + 2x$", "$-2x$", "$20$"],
            correct: 0,
            explanation: "Derivando: $(100)'=0$, $(20x)'=20$, $(-x^2)'=-2x$. Sumando: $20-2x$."
        },

        // ==================== SECCIÓN 4: Optimización básica ====================
        {
            q: "Para $f(x) = -x^2 + 10x$, encuentre dónde $f'(x) = 0$ y evalúe el máximo.",
            options: ["$x=5$, $f(5)=25$", "$x=10$, $f(10)=0$", "$x=0$, $f(0)=0$", "$x=2$, $f(2)=16$"],
            correct: 0,
            explanation: "$f'(x) = -2x + 10$. Igualando a cero: $-2x+10=0 \\Rightarrow x=5$. $f(5)=-25+50=25$."
        },
        {
            q: "Para $g(x) = x^2 - 6x + 8$, encuentre dónde $g'(x) = 0$ y determine si es mínimo.",
            options: ["$x=3$, mínimo", "$x=3$, máximo", "$x=2$, mínimo", "$x=4$, mínimo"],
            correct: 0,
            explanation: "$g'(x)=2x-6=0 \\Rightarrow x=3$. $g''(x)=2>0$, por lo que es un mínimo. $g(3)=9-18+8=-1$."
        },
        {
            q: "Para $R(x) = 50x - x^2$ (ingresos), encuentre dónde se maximizan los ingresos.",
            options: ["$x=25$", "$x=50$", "$x=0$", "$x=10$"],
            correct: 0,
            explanation: "$R'(x)=50-2x=0 \\Rightarrow x=25$. $R''(x)=-2<0$, por lo que es un máximo."
        },
        {
            q: "Para $C(x) = x^2 - 8x + 20$ (costo), encuentre dónde se minimiza el costo.",
            options: ["$x=4$", "$x=8$", "$x=0$", "$x=2$"],
            correct: 0,
            explanation: "$C'(x)=2x-8=0 \\Rightarrow x=4$. $C''(x)=2>0$, por lo que es un mínimo."
        }
    ];

    let currentQ = 0;
    let correctCount = 0;
    let errorCount = 0;
    let studentName = "";
    let answered = false;
    const MAX_ERRORS = 10;

    // Establecer fecha de hoy por defecto
    const fechaInput = document.getElementById('fecha');
    if (fechaInput) {
        const hoy = new Date();
        const año = hoy.getFullYear();
        const mes = String(hoy.getMonth() + 1).padStart(2, '0');
        const dia = String(hoy.getDate()).padStart(2, '0');
        fechaInput.value = `${año}-${mes}-${dia}`;
    }

    function startQuiz() {
        const nameInput = document.getElementById('nombre').value.trim();
        const dateInput = document.getElementById('fecha').value;
        if(!nameInput || !dateInput) {
            alert("Por favor, ingresa tu nombre y la fecha.");
            return;
        }
        studentName = nameInput;
        document.getElementById('registro').classList.add('hidden');
        document.getElementById('actividad').classList.remove('hidden');
        loadQuestion();
    }

    function loadQuestion() {
        answered = false;
        const q = questions[currentQ];
        document.getElementById('q-text').innerHTML = `<strong>Pregunta ${currentQ + 1}:</strong><br>${q.q}`;
        const container = document.getElementById('options-container');
        container.innerHTML = '';
        
        q.options.forEach((opt, i) => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerHTML = opt;
            btn.onclick = () => selectOption(i, btn);
            container.appendChild(btn);
        });
        document.getElementById('feedback').style.display = 'none';
        document.getElementById('btn-next').disabled = true;
        updateStats();
        
        if (window.MathJax && MathJax.typesetPromise) {
            MathJax.typesetPromise();
        }
    }

    function selectOption(index, btn) {
        if(answered) return;
        document.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        document.getElementById('btn-next').disabled = false;
        btn.dataset.index = index;
    }

    function nextQuestion() {
        if(!answered) {
            const selected = document.querySelector('.option-btn.selected');
            if(!selected) {
                alert("Por favor, selecciona una respuesta antes de continuar.");
                return;
            }
            const idx = parseInt(selected.dataset.index);
            checkAnswer(idx);
            answered = true;
            document.getElementById('btn-next').innerText = (currentQ < questions.length - 1) ? "Siguiente Pregunta" : "Finalizar";
            if (window.MathJax && MathJax.typesetPromise) {
                MathJax.typesetPromise();
            }
        } else {
            currentQ++;
            if(currentQ < questions.length) {
                loadQuestion();
                document.getElementById('btn-next').innerText = "Siguiente";
            } else {
                showResults();
            }
        }
    }

    function checkAnswer(selectedIdx) {
        const q = questions[currentQ];
        const isCorrect = selectedIdx === q.correct;
        const feedback = document.getElementById('feedback');
        const btns = document.querySelectorAll('.option-btn');

        btns.forEach(b => b.classList.add('disabled'));
        btns[q.correct].classList.add('correct');

        if(isCorrect) {
            correctCount++;
            feedback.className = "feedback correct";
            feedback.innerHTML = "<strong>¡Excelente!</strong> " + q.explanation;
        } else {
            errorCount++;
            btns[selectedIdx].classList.add('incorrect');
            feedback.className = "feedback incorrect";
            feedback.innerHTML = "<strong>Incorrecto.</strong> " + q.explanation;
            
            if(errorCount >= MAX_ERRORS) {
                setTimeout(() => {
                    alert(`Has alcanzado el límite de ${MAX_ERRORS} errores. Te recomendamos repasar: interpretación geométrica de la derivada, regla de potencia, derivación de polinomios y optimización básica.`);
                    location.reload();
                }, 1500);
            }
        }
        feedback.style.display = 'block';
        updateStats();
    }

    function updateStats() {
        document.getElementById('correct-count').innerText = correctCount;
        document.getElementById('error-count').innerText = errorCount;
        const prog = Math.round((currentQ / questions.length) * 100);
        document.getElementById('progress-pct').innerText = prog + "%";
        document.getElementById('progress-bar').style.width = prog + "%";
    }

    function showResults() {
        document.getElementById('actividad').classList.add('hidden');
        document.getElementById('resultados').classList.remove('hidden');
        document.getElementById('student-name-display').innerText = studentName;
        const score = Math.round((correctCount / questions.length) * 100);
        document.getElementById('final-score').innerText = score + "%";
        
        let msg = score >= 80 ? 
            "¡Excelente trabajo! Dominas el concepto de derivada: interpretación geométrica, regla de potencia, derivación de polinomios y optimización básica." : 
            "Buen esfuerzo. Te sugerimos repasar la interpretación geométrica de la derivada como pendiente de la tangente, la regla de potencia y cómo encontrar puntos críticos para optimización.";
        document.getElementById('personal-message').innerText = msg;
    }
</script>
</body>
</html>
